PORT=8000

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
VEHICLE_INITIAL_FUEL_FRACTION=1
STATION_CORRIDOR_MILES=10

ROUTING_PROVIDER=routing.services.providers.OSRMProvider
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=15
ROUTE_CACHE_SECONDS=3600
